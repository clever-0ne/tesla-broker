# Tesla XTeam FX Trade — environment variables
# Copy to `.env` for local use, or set these in the host dashboard (Render).
# Everything has a safe default, so an empty env works too — the values
# below are the ones that matter in production.

# Web server port. Render injects PORT automatically — do NOT set it there.
PORT=3000

# "true" makes the session cookie Secure (only sent over HTTPS).
# Set to true on Render because Render serves HTTPS.
HTTPS=true

# JSON data directory. Defaults to ./data inside the app folder, which is
# EPHEMERAL on Render (resets on deploy/restart). Point it at a persistent
# disk mount to keep accounts and balances, e.g. DATA_DIR=/var/data
DATA_DIR=/var/data

# Admin console password (password-only login). Default is biggod.
# Set a strong value in production if you want something else.
ADMIN_PASSWORD=biggod

# Node environment. Render sets this itself.
NODE_ENV=production
